// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",

      "ctrl-alt-h": "vim::ResizePaneLeft",
      "ctrl-alt-j": "vim::ResizePaneDown",
      "ctrl-alt-k": "vim::ResizePaneUp",
      "ctrl-alt-l": "vim::ResizePaneRight",
    },
  },
  {
    "context": "vim_mode == normal || EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      // Oil style open explorer
      "backspace": "vim::ToggleProjectPanelFocus",
      // TODO: Can't manage to deploy without having word under cursor as prefilled search
      "space f s": ["pane::DeploySearch", {}],
      "space f d": "diagnostics::Deploy",
      "space a a": "agent::Toggle",
    },
  },
  {
    "bindings": {
      "cmd-g cmd-g": ["task::Spawn", { "task_name": "start lazygit" }],
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "space c a": "editor::ToggleCodeActions",
      "space c d": "editor::ToggleInlineDiagnostics",
      "space g b": "editor::BlameHover",
      "space g B": "git::Blame",
      "space c f": "editor::Format",
    },
  },
  {
    "context": "vim_mode == visual || vim_mode == visual_line || vim_mode == visual_block",
    "bindings": {
      // Allow tabbing for indentation in visual mode
      "tab": ["workspace::SendKeystrokes", "> g v"],
      "shift-tab": ["workspace::SendKeystrokes", "< g v"],
      "space c f": "editor::FormatSelections",
    },
  },
  {
    // Subword keybinds
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd",
    },
  },
  {
    "context": "Picker > Editor",
    "bindings": {
      "ctrl-space": "picker::ConfirmCompletion",
    },
  },
  {
    "context": "(Editor && showing_completions)",
    "bindings": {
      "ctrl-space": "editor::ComposeCompletion",
    },
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "enter": [
        "action::Sequence",
        ["project_panel::Open", "project_panel::Toggle"],
      ],
    },
  },
]
